<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" xmlns:mso="http://schemas.microsoft.com/office/2009/07/customui" onLoad="CustomUI.OnLoad">
  <ribbon>
    <tabs>
      <tab id="SampleTab" label="Sample Tab" getVisible="CustomUI.SampleTab_getVisible">
        <group id="SampleGroup" label="Sample Group" centerVertically="true">
            <editBox id="SampleText" label="Sample Text" sizeString="wwwwwwwwwww" getText="SampleTabModule.SampleText_getText" onChange="SampleTabModule.SampleText_onChange"/>
            <button id="SampleButton" label="Search" imageMso="FindDialog" size="normal" onAction="SampleTabModule.SampleButton_onAction"/>
        </group>
        <group id="AppIntroductionGroup" label="App Introduction" centerVertically="true">
            <button id="AppIntroductionButton" label="App Introduction" imageMso="ItemProperties" size="normal" onAction="SampleTabModule.AppIntroductionButton_onAction"/>
        </group>
        <group id="RegisterProductGroup" label="Register Product" centerVertically="true">
            <button id="RegisterProductButton" label="Register Product" imageMso="FileProperties" size="normal" onAction="SampleTabModule.RegisterProductButton_onAction"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
